---
import Layout from '../layouts/Layout.astro';
import { seoPages } from '../lib/seo_pages';
---

<Layout
  title="ClearBreath — Breathe with intention"
  description="Guest-first breathing exercises with guided pacing, streaks, and a complete pranayama library."
>
  <section class="py-8">
    <h1 class="text-5xl tracking-tight font-light text-white">Breathe with intention.</h1>
    <p class="mt-4 text-lg text-white/70">
      ClearBreath is a guest-first pranayama and breathing exercise app with guided pacing,
      calming cues, and offline-first tracking.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="#download"
        class="inline-flex items-center justify-center rounded-xl bg-white text-black px-5 py-3 text-sm font-semibold"
      >
        Get the app
      </a>
      <a
        href="/privacy"
        class="inline-flex items-center justify-center rounded-xl border border-white/15 text-white px-5 py-3 text-sm font-semibold hover:border-white/25"
      >
        Privacy
      </a>
    </div>
  </section>

  <section class="py-8 border-t border-white/10">
    <h2 class="text-xl font-semibold text-white">What you get</h2>
    <ul class="mt-4 grid gap-3 text-white/70">
      <li>9 techniques with clear, paced guidance (more planned)</li>
      <li>Streaks and weekly minutes (week starts Monday)</li>
      <li>Background playback and lock-screen controls</li>
      <li>Guest mode by default, sign-in optional for leaderboard and cloud backup</li>
    </ul>
  </section>

  <section class="py-8 border-t border-white/10">
    <h2 class="text-xl font-semibold text-white">Technique pages</h2>
    <p class="mt-2 text-white/70">
      Learn the basics, get safe guidance, and use ClearBreath as your timer.
    </p>
    <div class="mt-4 grid gap-3">
      {seoPages
        .filter((p) => p.kind === 'technique')
        .map((page) => (
          <a
            href={`/${page.slug}`}
            class="rounded-2xl border border-white/10 px-5 py-4 hover:border-white/20 transition-colors"
          >
            <div class="text-white font-semibold">{page.h1}</div>
            <div class="mt-1 text-sm text-white/65">{page.description}</div>
          </a>
        ))}
    </div>
  </section>

  <section id="download" class="py-8 border-t border-white/10">
    <h2 class="text-xl font-semibold text-white">Download</h2>
    <p class="mt-2 text-white/70">
      iOS and Android download links will be posted here once store listings are live.
    </p>
  </section>
</Layout>
