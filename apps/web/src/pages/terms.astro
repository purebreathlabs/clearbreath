---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Terms of Service — ClearBreath"
  description="ClearBreath terms of service and safety disclaimers."
>
  <article class="space-y-10">
    <header class="space-y-3">
      <h1 class="text-4xl tracking-tight font-light text-white">
        Terms of Service
      </h1>
      <p class="text-sm text-white/60">Last updated: 2026-02-22</p>
    </header>

    <section class="space-y-4">
      <p class="text-white/70">
        ClearBreath provides guided breathing exercises. By using the app, you
        agree to these terms.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-white">Not Medical Advice</h2>
      <p class="text-white/70">
        ClearBreath is not medical advice. Breathing practices may not be
        appropriate for everyone. Stop if you feel unwell and consult a
        qualified professional if you have medical concerns.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-white">Your Responsibility</h2>
      <ul class="list-disc pl-5 text-white/70 space-y-2">
        <li>Use the app safely and responsibly.</li>
        <li>
          Follow any technique-specific safety guidance shown in the app.
        </li>
      </ul>
    </section>

    <section class="space-y-3">
      <h2 class="text-xl font-semibold text-white">Service Availability</h2>
      <p class="text-white/70">
        We may update, change, or discontinue features over time.
      </p>
    </section>

    <section class="space-y-2 border-t border-white/10 pt-8">
      <h2 class="text-xl font-semibold text-white">Contact</h2>
      <p class="text-white/70">
        If you have questions, contact support at:{' '}
        <a
          href="mailto:support@clearbreath.life"
          class="text-white hover:underline"
        >
          support@clearbreath.life
        </a>
      </p>
    </section>
  </article>
</Layout>

