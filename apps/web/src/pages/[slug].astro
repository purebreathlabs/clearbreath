---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';

import Layout from '../layouts/Layout.astro';
import { seoPages, type SeoPage } from '../lib/seo_pages';

type MobileTechnique = {
  id: string;
  name: string;
  shortDescription: string;
  safety: {
    requiresAck: boolean;
    title: string;
    body: string;
  };
  about: {
    what: string;
    how: string;
    bestTime: string;
    benefits: string;
    warnings: string;
  };
};

const techniquesPath = resolve(
  process.cwd(),
  '../mobile/assets/techniques/techniques_v1.json',
);
const techniques = JSON.parse(
  await readFile(techniquesPath, 'utf8'),
) as MobileTechnique[];

export function getStaticPaths() {
  return seoPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: SeoPage };
const technique =
  page.kind === 'technique'
    ? techniques.find((t) => t.id === page.techniqueId)
    : null;

if (page.kind === 'technique' && !technique) {
  throw new Error(`Missing technique data for ${page.slug}`);
}

const sleepSuggestions = [
  '478-breathing-timer',
  'bhramari-bee-breathing',
  'hrv-resonance-breathing',
];
const sleepPages = seoPages.filter((p) => sleepSuggestions.includes(p.slug));

const imageMap: Record<string, string> = {
  'hrv_resonance': '/images/hrv.png',
  'ultra_slow': '/images/addtional-3.png',
  'box': '/images/box-breathing.png',
  'four_seven_eight': '/images/addition.png',
  'anulom_vilom': '/images/anulom-vilom.png',
  'ujjayi': '/images/ujjayi.png',
  'bhramari': '/images/bhramari.png',
  'kapalbhati': '/images/kapaalbhati.png',
  'bhastrika': '/images/bhastrika.png',
};

const imageUrl = (page.kind === 'technique' && page.techniqueId) ? imageMap[page.techniqueId] : '/images/addition-2.png';
---

<Layout title={page.title} description={page.description}>
  <article class="flex flex-col gap-12 lg:gap-20">
    {/* HERO SECTION FOR TECHNIQUE */}
    <header class="flex flex-col md:flex-row gap-10 items-center">
      <div class="flex-1 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/5 text-xs font-medium text-white/80 uppercase tracking-widest">
          {page.kind === 'technique' ? 'Technique Guide' : 'Wellness Guide'}
        </div>
        <h1 class="text-4xl md:text-6xl tracking-tight font-semibold text-white leading-tight">
          {page.h1}
        </h1>
        <p class="text-lg text-white/70 font-light leading-relaxed max-w-xl">
          {page.description}
        </p>
        <div class="pt-4 flex flex-wrap gap-4">
          <a
            href="/#download"
            class="inline-flex h-12 items-center justify-center rounded-full bg-white text-black px-8 text-sm font-semibold transition-transform hover:scale-105"
          >
            Get ClearBreath
          </a>
          <a
            href="/terms"
            class="inline-flex h-12 items-center justify-center rounded-full border border-white/20 text-white px-8 text-sm font-medium hover:bg-white/5 transition-colors"
          >
            Disclaimer
          </a>
        </div>
      </div>
      
      <div class="w-full md:w-1/2 flex justify-center relative">
        <div class="absolute inset-0 bg-gradient-to-tr from-white/5 to-transparent rounded-3xl blur-2xl transform scale-95 -z-10"></div>
        {imageUrl && (
          <img 
            src={imageUrl} 
            alt={page.h1} 
            class="w-full max-w-[400px] object-contain drop-shadow-[0_0_30px_rgba(255,255,255,0.1)] rounded-3xl"
          />
        )}
      </div>
    </header>

    <div class="w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent my-4"></div>

    {/* CONTENT SECTION */}
    <div class="grid md:grid-cols-[1fr_300px] gap-12">
      <div class="space-y-12">
        {page.kind === 'hub' ? (
          <section class="space-y-6">
            <h2 class="text-2xl font-semibold text-white tracking-tight">Techniques to try</h2>
            <p class="text-white/70 font-light leading-relaxed">
              If you are winding down for the night, start gentle and keep the breath
              comfortable. If any technique feels uncomfortable, stop and return to
              normal breathing.
            </p>
            <div class="grid gap-4 mt-6">
              {sleepPages.map((p) => (
                <a
                  href={`/${p.slug}`}
                  class="group flex flex-col justify-center rounded-2xl border border-white/10 bg-white/[0.02] p-6 hover:bg-white/[0.04] hover:border-white/30 transition-all duration-300"
                >
                  <div class="text-lg text-white font-medium mb-2 group-hover:text-white transition-colors">{p.h1}</div>
                  <div class="text-sm text-white/60 font-light leading-relaxed">{p.description}</div>
                </a>
              ))}
            </div>
          </section>
        ) : (
          <>
            <section class="space-y-8">
              <div class="space-y-3">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center">
                    <span class="text-white text-sm font-bold">1</span>
                  </div>
                  <h2 class="text-2xl font-semibold text-white tracking-tight">What it is</h2>
                </div>
                <p class="text-white/70 font-light leading-relaxed pl-11">{technique!.about.what}</p>
              </div>

              <div class="space-y-3">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center">
                    <span class="text-white text-sm font-bold">2</span>
                  </div>
                  <h2 class="text-2xl font-semibold text-white tracking-tight">How to do it</h2>
                </div>
                <p class="text-white/70 font-light leading-relaxed pl-11">{technique!.about.how}</p>
              </div>

              <div class="space-y-3">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center">
                    <span class="text-white text-sm font-bold">3</span>
                  </div>
                  <h2 class="text-2xl font-semibold text-white tracking-tight">Benefits</h2>
                </div>
                <p class="text-white/70 font-light leading-relaxed pl-11">{technique!.about.benefits}</p>
              </div>
            </section>
          </>
        )}
      </div>

      {/* SIDEBAR */}
      <aside class="space-y-8">
        {page.kind === 'technique' && (
          <div class="rounded-3xl border border-white/10 bg-neutral-900/50 p-6 space-y-6">
            <div>
              <h3 class="text-xs font-semibold text-white/40 uppercase tracking-widest mb-2">Best Time</h3>
              <p class="text-white/80 font-light text-sm leading-relaxed">{technique!.about.bestTime}</p>
            </div>
            
            <div class="h-px w-full bg-white/10"></div>
            
            <div>
              <h3 class="text-xs font-semibold text-white/40 uppercase tracking-widest mb-2">Warnings</h3>
              <p class="text-white/80 font-light text-sm leading-relaxed">{technique!.about.warnings}</p>
            </div>
          </div>
        )}

        {page.kind === 'technique' && (technique!.safety.requiresAck || technique!.safety.body.trim()) && (
          <div class="rounded-3xl border border-red-500/20 bg-red-500/5 p-6 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-red-500/50 to-transparent"></div>
            <h3 class="text-sm font-semibold text-red-400 mb-3 flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              {technique!.safety.title || 'Safety guidance'}
            </h3>
            <p class="text-white/70 font-light text-sm leading-relaxed">
              {technique!.safety.body.trim() || 'Practice gently. Stop if you feel unwell.'}
            </p>
          </div>
        )}
        
        <div class="rounded-3xl border border-white/5 bg-white/[0.02] p-6 text-sm text-white/50 font-light">
          ClearBreath is for wellness and relaxation purposes only. It is not medical advice and does not diagnose, treat, cure, or prevent any disease.
        </div>
      </aside>
    </div>
  </article>
</Layout>
